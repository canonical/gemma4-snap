#!/bin/bash -eu

port="$(modelctl get http.port)"
host="$(modelctl get http.host)"
sleep_idle_seconds="$(modelctl get sleep-idle-seconds)"
min_context_size="$(modelctl get min-context-size)"
model_name=$("$SNAP_NAME" model --format=json | jq -r '.name')

extra_args=()
verbose="$(modelctl get verbose)"
if [ "${verbose}" = "true" ]; then
  extra_args+=(--verbose)
fi

mmproj_args=()
if [ -n "${MMPROJ_FILE:-}" ]; then
  mmproj_args=(--mmproj "$MMPROJ_FILE")
fi

mtp_args=()
mtp_enabled="$(modelctl get mtp-enabled)"
if [ "${mtp_enabled}" = "true" ]; then
  if [ ! -f "${MTP_FILE:-}" ]; then
    echo "MTP is enabled but $MTP_FILE is missing. Starting without MTP. Install the MTP component for this model to enable it." >&2
  else
    mtp_args=(-md "$MTP_FILE" --spec-type draft-mtp --spec-draft-n-max "$(modelctl get spec-draft-n-max)")
  fi
fi

moe_args=()
moe_cache_mib="$(modelctl get moe-cache-mib)"
if [[ "${moe_cache_mib}" =~ ^[0-9]+$ ]] && [ "${moe_cache_mib}" -gt 0 ]; then
  if [ "${model_name}" = "gemma4-26b-a4b" ] || [ "${model_name}" = "gemma4-26b-a4b-qat" ]; then
    moe_args=(-cmoe --moe-cache-mib "${moe_cache_mib}")
    moe_cache_cpu_share="$(modelctl get moe-cache-cpu-share)"
    if [[ "${moe_cache_cpu_share}" =~ ^(0|1|0?\.[0-9]+|1\.0+)$ ]]; then
      moe_args+=(--moe-cache-cpu-share "${moe_cache_cpu_share}")
    else
      echo "Invalid moe-cache-cpu-share value '${moe_cache_cpu_share}' (expected float in [0,1]). Option ignored." >&2
    fi
  else
    echo "MoE cache requested but $model_name is not a MoE model. Option ignored." >&2
  fi
fi

set -x
# Adding --no-warmup to skip the model warmup phase during server startup in order to reduce resource usage if not needed.
exec llama-server \
  --model "$MODEL_FILE" \
  --alias "$model_name" \
  "${mmproj_args[@]}" \
  --port "$port" \
  --host "$host" \
  --no-warmup \
  --sleep-idle-seconds "$sleep_idle_seconds" \
  --fit-ctx "$min_context_size" \
  "${extra_args[@]}" \
  "${mtp_args[@]}" \
  "${moe_args[@]}" \
  "$@"
